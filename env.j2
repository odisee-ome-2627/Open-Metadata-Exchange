{#- Every value is double quoted: `uv run --env-file` can't read an unquoted value with
    a space in it, and then loads nothing from this file. Inside the quotes \, " and $
    need a backslash. -#}
{%- macro q(value) -%}
"{{ value | string | replace('\\', '\\\\') | replace('"', '\\"') | replace('$', '\\$') }}"
{%- endmacro -%}
