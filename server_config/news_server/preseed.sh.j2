#!/usr/bin/bash

{#- The DSpace channel from dspace.newsgroup comes first, then the extra local_newsgroups. -#}
{%- set groups = local_newsgroups | default([]) | list %}
{%- set dspace_group = (dspace | default({})).newsgroup | default("") %}
{%- if dspace_group and dspace_group not in groups %}
{%- set groups = [dspace_group] + groups %}
{%- endif %}

{% for group in groups %}
ctlinnd newgroup '{{ group }}'
{% endfor %}

{% for peer in peers %}
/usr/lib/news/bin/actsync -v 4 -m -ox -p 0  localhost {{peer.dns_name}}:{{peer.port}}
/usr/lib/news/bin/getlist -h localhost | \
    sed -n 's/^\(ome\.[^ ]*\) .*/\t\1/pg' | \
    awk 'BEGIN{print("{{peer.dns_name}}:{{peer.port}}");}{print($0);}' > /root/pullnews.marks
/usr/lib/news/bin/pullnews

{% endfor %}
